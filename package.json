{
  "name": "chip-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.js",
    "test:core": "bash scripts/test-core.sh",
    "test:protocol": "bash scripts/test-protocol.sh",
    "test:web": "node --test test/companion.test.mjs",
    "test": "npm run test:core && npm run test:protocol && npm run test:web",
