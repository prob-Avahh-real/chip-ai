    "export:demo": "python3 tooling/export_demo_tflite.py",
    "test:flutter": "cd mobile/flutter && flutter test"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
